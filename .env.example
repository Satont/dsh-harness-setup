# Copy to .env / password manager. NEVER commit the filled file.
# This file contains names only; values are placeholders.

# ── home / profile ──────────────────────────────────────────────────────────
DSH_HOME=/home/YOUR_USER/.dsh
DSH_PROFILE=web

# ── VPS relay ───────────────────────────────────────────────────────────────
VPS_SSH_HOST=dsh-vps
VPS_IP=203.0.113.10
PUBLIC_HOST=203-0-113-10.sslip.io
TAILSCALE_IP=100.64.0.10
BASIC_USER=dsh
BASIC_PASS=CHANGE_ME_LONG_RANDOM

# ── static artifact share host ──────────────────────────────────────────────
SHARE_HOST=share.203-0-113-10.sslip.io
DSH_SHARE_SSH_HOST=dsh-vps
DSH_SHARE_REMOTE_DIR=/srv/dsh-share
DSH_SHARE_PUBLIC_BASE=https://share.203-0-113-10.sslip.io

# ── optional provider keys (prefer the DSH UI) ──────────────────────────────
# DEEPSEEK_API_KEY=
# CONTEXT7_API_KEY=
# GITLAB_HOST=gitlab.example.com

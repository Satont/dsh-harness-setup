{
  "name": "dsh-limits-strip",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Compact always-visible limits summary above the DSH composer; clicks through to the full Limits panel.",
  "main": "lib/index.js",
  "exports": {
    ".": { "default": "./lib/index.js" },
    "./client": { "default": "./lib/client.js" },
    "./package.json": "./package.json"
  },
  "files": ["lib/", "cordis.patch.yml"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "immediately": true }
  }
}

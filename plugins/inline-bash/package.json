{
  "name": "dsh-inline-bash",
  "version": "0.1.0",
  "private": true,
  "description": "Claude-Code-style inline bash for the DSH Web composer: type !cmd and press Enter to run a local shell command in the Session working directory without a model turn.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [],
      "immediately": true
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "src",
    "scripts",
    "README.md"
  ]
}
